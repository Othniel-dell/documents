{
  "expo": {
    "name": "DocuSmart AI",
    "slug": "documents",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/docusmart-logo.png",
    "scheme": "documents",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/docusmart-logo.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/docusmart-logo.png",
        "backgroundImage": "./assets/images/docusmart-logo.png",
        "monochromeImage": "./assets/images/docusmart-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.othniel123.documents"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/docusmart-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#16325B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow CamDocs to access your camera to scan documents, forms, and ID cards."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow CamDocs to access your photos to import and edit documents."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "bb6e29c5-b02c-469f-86b0-68af002ec8d8"
      }
    }
  }
}
